<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.wordyl.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label fx:id="infor" text="" textFill="#333333">
        <font>
            <Font name="System Bold" size="14.0" />
        </font>
    </Label>
    <GridPane fx:id="wordGrid" alignment="CENTER" hgap="5.0" vgap="5.0">
        <!-- Wiersz 0 -->
        <Label alignment="CENTER" prefHeight="50.0" prefWidth="50.0" style="-fx-border-color: #d3d3d3; -fx-border-width: 2px; -fx-background-color: white; -fx-font-size: 28px; -fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <Label alignment="CENTER" prefHeight="50.0" prefWidth="50.0" style="-fx-border-color: #d3d3d3; -fx-border-width: 2px; -fx-background-color: white; -fx-font-size: 28px; -fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="0" />
        <Label alignment="CENTER" prefHeight="50.0" prefWidth="50.0" style="-fx-border-color: #d3d3d3; -fx-border-width: 2px; -fx-background-color: white; -fx-font-size: 28px; -fx-font-weight: bold;" GridPane.columnIndex="2" GridPane.rowIndex="0" />
        <Label alignment="CENTER" prefHeight="50.0" prefWidth="50.0" style="-fx-border-color: #d3d3d3; -fx-border-width: 2px; -fx-background-color: white; -fx-font-size: 28px; -fx-font-weight: bold;" GridPane.columnIndex="3" GridPane.rowIndex="0" />
        <Label alignment="CENTER" prefHeight="50.0" prefWidth="50.0" style="-fx-border-color: #d3d3d3; -fx-border-width: 2px; -fx-background-color: white; -fx-font-size: 28px; -fx-font-weight: bold;" GridPane.columnIndex="4" GridPane.rowIndex="0" />

        <!-- Wiersz 1 -->
        <Label alignment="CENTER" prefHeight="50.0" prefWidth="50.0" style="-fx-border-color: #d3d3d3; -fx-border-width: 2px; -fx-background-color: white; -fx-font-size: 28px; -fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <Label alignment="CENTER" prefHeight="50.0" prefWidth="50.0" style="-fx-border-color: #d3d3d3; -fx-border-width: 2px; -fx-background-color: white; -fx-font-size: 28px; -fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="1" />
        <Label alignment="CENTER" prefHeight="50.0" prefWidth="50.0" style="-fx-border-color: #d3d3d3; -fx-border-width: 2px; -fx-background-color: white; -fx-font-size: 28px; -fx-font-weight: bold;" GridPane.columnIndex="2" GridPane.rowIndex="1" />
        <Label alignment="CENTER" prefHeight="50.0" prefWidth="50.0" style="-fx-border-color: #d3d3d3; -fx-border-width: 2px; -fx-background-color: white; -fx-font-size: 28px; -fx-font-weight: bold;" GridPane.columnIndex="3" GridPane.rowIndex="1" />
        <Label alignment="CENTER" prefHeight="50.0" prefWidth="50.0" style="-fx-border-color: #d3d3d3; -fx-border-width: 2px; -fx-background-color: white; -fx-font-size: 28px; -fx-font-weight: bold;" GridPane.columnIndex="4" GridPane.rowIndex="1" />

        <!-- Wiersz 2 -->
        <Label alignment="CENTER" prefHeight="50.0" prefWidth="50.0" style="-fx-border-color: #d3d3d3; -fx-border-width: 2px; -fx-background-color: white; -fx-font-size: 28px; -fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <Label alignment="CENTER" prefHeight="50.0" prefWidth="50.0" style="-fx-border-color: #d3d3d3; -fx-border-width: 2px; -fx-background-color: white; -fx-font-size: 28px; -fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="2" />
        <Label alignment="CENTER" prefHeight="50.0" prefWidth="50.0" style="-fx-border-color: #d3d3d3; -fx-border-width: 2px; -fx-background-color: white; -fx-font-size: 28px; -fx-font-weight: bold;" GridPane.columnIndex="2" GridPane.rowIndex="2" />
        <Label alignment="CENTER" prefHeight="50.0" prefWidth="50.0" style="-fx-border-color: #d3d3d3; -fx-border-width: 2px; -fx-background-color: white; -fx-font-size: 28px; -fx-font-weight: bold;" GridPane.columnIndex="3" GridPane.rowIndex="2" />
        <Label alignment="CENTER" prefHeight="50.0" prefWidth="50.0" style="-fx-border-color: #d3d3d3; -fx-border-width: 2px; -fx-background-color: white; -fx-font-size: 28px; -fx-font-weight: bold;" GridPane.columnIndex="4" GridPane.rowIndex="2" />

        <!-- Wiersz 3 -->
        <Label alignment="CENTER" prefHeight="50.0" prefWidth="50.0" style="-fx-border-color: #d3d3d3; -fx-border-width: 2px; -fx-background-color: white; -fx-font-size: 28px; -fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <Label alignment="CENTER" prefHeight="50.0" prefWidth="50.0" style="-fx-border-color: #d3d3d3; -fx-border-width: 2px; -fx-background-color: white; -fx-font-size: 28px; -fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="3" />
        <Label alignment="CENTER" prefHeight="50.0" prefWidth="50.0" style="-fx-border-color: #d3d3d3; -fx-border-width: 2px; -fx-background-color: white; -fx-font-size: 28px; -fx-font-weight: bold;" GridPane.columnIndex="2" GridPane.rowIndex="3" />
        <Label alignment="CENTER" prefHeight="50.0" prefWidth="50.0" style="-fx-border-color: #d3d3d3; -fx-border-width: 2px; -fx-background-color: white; -fx-font-size: 28px; -fx-font-weight: bold;" GridPane.columnIndex="3" GridPane.rowIndex="3" />
        <Label alignment="CENTER" prefHeight="50.0" prefWidth="50.0" style="-fx-border-color: #d3d3d3; -fx-border-width: 2px; -fx-background-color: white; -fx-font-size: 28px; -fx-font-weight: bold;" GridPane.columnIndex="4" GridPane.rowIndex="3" />

        <!-- Wiersz 4 -->
        <Label alignment="CENTER" prefHeight="50.0" prefWidth="50.0" style="-fx-border-color: #d3d3d3; -fx-border-width: 2px; -fx-background-color: white; -fx-font-size: 28px; -fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="4" />
        <Label alignment="CENTER" prefHeight="50.0" prefWidth="50.0" style="-fx-border-color: #d3d3d3; -fx-border-width: 2px; -fx-background-color: white; -fx-font-size: 28px; -fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="4" />
        <Label alignment="CENTER" prefHeight="50.0" prefWidth="50.0" style="-fx-border-color: #d3d3d3; -fx-border-width: 2px; -fx-background-color: white; -fx-font-size: 28px; -fx-font-weight: bold;" GridPane.columnIndex="2" GridPane.rowIndex="4" />
        <Label alignment="CENTER" prefHeight="50.0" prefWidth="50.0" style="-fx-border-color: #d3d3d3; -fx-border-width: 2px; -fx-background-color: white; -fx-font-size: 28px; -fx-font-weight: bold;" GridPane.columnIndex="3" GridPane.rowIndex="4" />
        <Label alignment="CENTER" prefHeight="50.0" prefWidth="50.0" style="-fx-border-color: #d3d3d3; -fx-border-width: 2px; -fx-background-color: white; -fx-font-size: 28px; -fx-font-weight: bold;" GridPane.columnIndex="4" GridPane.rowIndex="4" />

        <!-- Wiersz 5 -->
        <Label alignment="CENTER" prefHeight="50.0" prefWidth="50.0" style="-fx-border-color: #d3d3d3; -fx-border-width: 2px; -fx-background-color: white; -fx-font-size: 28px; -fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="5" />
        <Label alignment="CENTER" prefHeight="50.0" prefWidth="50.0" style="-fx-border-color: #d3d3d3; -fx-border-width: 2px; -fx-background-color: white; -fx-font-size: 28px; -fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="5" />
        <Label alignment="CENTER" prefHeight="50.0" prefWidth="50.0" style="-fx-border-color: #d3d3d3; -fx-border-width: 2px; -fx-background-color: white; -fx-font-size: 28px; -fx-font-weight: bold;" GridPane.columnIndex="2" GridPane.rowIndex="5" />
        <Label alignment="CENTER" prefHeight="50.0" prefWidth="50.0" style="-fx-border-color: #d3d3d3; -fx-border-width: 2px; -fx-background-color: white; -fx-font-size: 28px; -fx-font-weight: bold;" GridPane.columnIndex="3" GridPane.rowIndex="5" />
        <Label alignment="CENTER" prefHeight="50.0" prefWidth="50.0" style="-fx-border-color: #d3d3d3; -fx-border-width: 2px; -fx-background-color: white; -fx-font-size: 28px; -fx-font-weight: bold;" GridPane.columnIndex="4" GridPane.rowIndex="5" />
    </GridPane>

    <!-- Dolna Klawiatura Ekranowa -->
    <VBox fx:id="keyboardContainer" alignment="CENTER" spacing="5.0">
        <!-- Rząd 1 -->
        <HBox alignment="CENTER" spacing="5.0">
            <Button onAction="#handleScreenLetter" prefHeight="45.0" prefWidth="35.0" text="Q" />
            <Button onAction="#handleScreenLetter" prefHeight="45.0" prefWidth="35.0" text="W" />
            <Button onAction="#handleScreenLetter" prefHeight="45.0" prefWidth="35.0" text="E" />
            <Button onAction="#handleScreenLetter" prefHeight="45.0" prefWidth="35.0" text="R" />
            <Button onAction="#handleScreenLetter" prefHeight="45.0" prefWidth="35.0" text="T" />
            <Button onAction="#handleScreenLetter" prefHeight="45.0" prefWidth="35.0" text="Y" />
            <Button onAction="#handleScreenLetter" prefHeight="45.0" prefWidth="35.0" text="U" />
            <Button onAction="#handleScreenLetter" prefHeight="45.0" prefWidth="35.0" text="I" />
            <Button onAction="#handleScreenLetter" prefHeight="45.0" prefWidth="35.0" text="O" />
            <Button onAction="#handleScreenLetter" prefHeight="45.0" prefWidth="35.0" text="P" />
        </HBox>
        <!-- Rząd 2 -->
        <HBox alignment="CENTER" spacing="5.0">
            <Button onAction="#handleScreenLetter" prefHeight="45.0" prefWidth="35.0" text="A" />
            <Button onAction="#handleScreenLetter" prefHeight="45.0" prefWidth="35.0" text="S" />
            <Button onAction="#handleScreenLetter" prefHeight="45.0" prefWidth="35.0" text="D" />
            <Button onAction="#handleScreenLetter" prefHeight="45.0" prefWidth="35.0" text="F" />
            <Button onAction="#handleScreenLetter" prefHeight="45.0" prefWidth="35.0" text="G" />
            <Button onAction="#handleScreenLetter" prefHeight="45.0" prefWidth="35.0" text="H" />
            <Button onAction="#handleScreenLetter" prefHeight="45.0" prefWidth="35.0" text="J" />
            <Button onAction="#handleScreenLetter" prefHeight="45.0" prefWidth="35.0" text="K" />
            <Button onAction="#handleScreenLetter" prefHeight="45.0" prefWidth="35.0" text="L" />
        </HBox>
        <!-- Rząd 3 -->
        <HBox alignment="CENTER" spacing="5.0">
            <Button onAction="#handleScreenEnter" prefHeight="45.0" prefWidth="60.0" text="ENTER" />
            <Button onAction="#handleScreenLetter" prefHeight="45.0" prefWidth="35.0" text="Z" />
            <Button onAction="#handleScreenLetter" prefHeight="45.0" prefWidth="35.0" text="X" />
            <Button onAction="#handleScreenLetter" prefHeight="45.0" prefWidth="35.0" text="C" />
            <Button onAction="#handleScreenLetter" prefHeight="45.0" prefWidth="35.0" text="V" />
            <Button onAction="#handleScreenLetter" prefHeight="45.0" prefWidth="35.0" text="B" />
            <Button onAction="#handleScreenLetter" prefHeight="45.0" prefWidth="35.0" text="N" />
            <Button onAction="#handleScreenLetter" prefHeight="45.0" prefWidth="35.0" text="M" />
            <Button onAction="#handleScreenBackspace" prefHeight="45.0" prefWidth="60.0" text="BACK" />
        </HBox>
    </VBox>
</VBox>